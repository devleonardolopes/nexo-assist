# Copie para .env (raiz do repositório) e preencha.

# Chave do DeepSeek (https://platform.deepseek.com). Sem ela o login e o console funcionam, mas o agent não responde.
DEEPSEEK_API_KEY=

# Modelo usado pelo agent. deepseek-v4-flash: barato e rápido; use deepseek-v4-pro para mais qualidade.
LLM_MODEL=deepseek-v4-flash

# Banco SQLite. Local: arquivo. Em produção na Vercel use um libSQL/Turso para persistir.
# DATABASE_URL=file:./data/nexo.db
# DATABASE_AUTH_TOKEN=

# Proteções de custo/abuso (valores padrão).
# MESSAGE_LIMIT=30
# DAILY_LLM_CAP=2000
# IP_RATE_PER_MINUTE=20
# CONFIDENCE_THRESHOLD=0.6

# Simula a instabilidade do sistema de chamados legado (0 a 1). Útil para ver o tratamento de erro.
# LEGACY_FAILURE_RATE=0
